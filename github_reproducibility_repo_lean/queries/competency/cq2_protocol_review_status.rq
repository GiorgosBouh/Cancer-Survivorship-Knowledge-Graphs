PREFIX cskg: <https://w3id.org/cskg/ontology/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?protocol_id ?label ?expression ?min_days ?review_decision ?approved_status ?classification_type ?interpretation_limit
WHERE {
  ?protocol a cskg:ProcessingProtocol ;
    dct:identifier ?protocol_id ;
    rdfs:label ?label ;
    cskg:hasExecutableExpression ?expression ;
    cskg:minValidDays ?min_days .
  OPTIONAL { ?protocol cskg:protocolReviewDecision ?review_decision . }
  OPTIONAL { ?protocol cskg:protocolApprovedStatus ?approved_status . }
  OPTIONAL { ?protocol cskg:protocolClassificationType ?classification_type . }
  OPTIONAL { ?protocol cskg:protocolInterpretationLimit ?interpretation_limit . }
}
ORDER BY ?protocol_id
