PREFIX cskg: <https://w3id.org/cskg/ontology/>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?participant_id ?diagnosis ?source_code ?source_label ?mapping_status ?candidate_vocabulary ?candidate_label
WHERE {
  ?participant a cskg:Participant ;
    dct:identifier ?participant_id ;
    cskg:hasCancerDiagnosis ?diagnosis .
  ?diagnosis cskg:hasCancerTypeCode ?source_code .
  OPTIONAL { ?diagnosis cskg:cancerTypeLabel ?source_label . }
  OPTIONAL { ?diagnosis cskg:cancerTypeMappingStatus ?mapping_status . }
  OPTIONAL { ?diagnosis cskg:cancerTypeExternalVocabulary ?candidate_vocabulary . }
  OPTIONAL { ?diagnosis cskg:cancerTypeExternalCandidateLabel ?candidate_label . }
}
ORDER BY ?participant_id ?diagnosis
