    cskg:termStatus "ready" .

cskg:protocolClassificationType
    a owl:DatatypeProperty ;
    rdfs:domain cskg:ProcessingProtocol ;
    rdfs:range xsd:string ;
    rdfs:label "protocol classification type" ;
    rdfs:comment "Operational class of a protocol, for example completeness rule or sensitivity completeness rule." ;
