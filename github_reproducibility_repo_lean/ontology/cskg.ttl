    rdfs:comment "Reviewed executable expression approved for a processing protocol." ;
    cskg:termStatus "ready" .

cskg:protocolApprovedMinValidDays
    a owl:DatatypeProperty ;
    rdfs:domain cskg:ProcessingProtocol ;
    rdfs:range xsd:integer ;
