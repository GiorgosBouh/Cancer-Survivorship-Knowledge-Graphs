cskg:protocolReviewerComment
    a owl:DatatypeProperty ;
    rdfs:domain cskg:ProcessingProtocol ;
    rdfs:range xsd:string ;
    rdfs:label "protocol reviewer comment" ;
    rdfs:comment "Reviewer comment explaining the protocol review decision." ;
    cskg:termStatus "ready" .

cskg:protocolReviewerName
    a owl:DatatypeProperty ;
    rdfs:domain cskg:ProcessingProtocol ;
    rdfs:range xsd:string ;
    rdfs:label "protocol reviewer name" ;
