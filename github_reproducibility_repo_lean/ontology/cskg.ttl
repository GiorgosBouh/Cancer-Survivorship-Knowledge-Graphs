cskg:cancerTypeExternalVocabulary
    a owl:DatatypeProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:range xsd:string ;
    rdfs:label "cancer type external vocabulary" ;
    rdfs:comment "Target external vocabulary proposed for cancer type mapping, for example NCIt." ;
    cskg:termStatus "ready" .

cskg:cancerTypeExternalCandidateLabel
    a owl:DatatypeProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:range xsd:string ;
    rdfs:label "cancer type external candidate label" ;
    rdfs:comment "Candidate external label used as a starting point for NCIt mapping review. This is not an asserted concept ID." ;
    cskg:termStatus "needs expert/ontology review" .

cskg:reviewedNCItConcept
    a owl:ObjectProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:label "reviewed NCIt concept" ;
    rdfs:comment "Reviewed NCI Thesaurus concept IRI asserted only as qualified mapping metadata for a self-reported NHANES cancer type code." ;
    cskg:termStatus "reviewed qualified mapping" .

cskg:reviewedNCItCode
    a owl:DatatypeProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:range xsd:string ;
    rdfs:label "reviewed NCIt code" ;
    rdfs:comment "Reviewed NCI Thesaurus code for the source cancer type code." ;
    cskg:termStatus "reviewed qualified mapping" .

cskg:reviewedNCItLabel
    a owl:DatatypeProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:range xsd:string ;
    rdfs:label "reviewed NCIt label" ;
    rdfs:comment "Reviewed NCI Thesaurus label for the source cancer type code." ;
    cskg:termStatus "reviewed qualified mapping" .

cskg:ncitMappingRelation
    a owl:DatatypeProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:range xsd:string ;
    rdfs:label "NCIt mapping relation" ;
    rdfs:comment "Reviewed mapping relation between the NHANES source code label and the NCI Thesaurus concept, for example exactMatch, closeMatch, or broadMatch." ;
    cskg:termStatus "reviewed qualified mapping" .

cskg:ncitReviewDecision
    a owl:DatatypeProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:range xsd:string ;
    rdfs:label "NCIt review decision" ;
    rdfs:comment "Reviewer decision imported from the completed cancer-code NCIt review sheet." ;
    cskg:termStatus "reviewed qualified mapping" .

cskg:ncitClinicalNoteRequired
    a owl:DatatypeProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:range xsd:string ;
    rdfs:label "NCIt clinical note required" ;
    rdfs:comment "Flag indicating whether the reviewer required a clinical caveat for the NCIt mapping." ;
    cskg:termStatus "reviewed qualified mapping" .

cskg:ncitReviewerComment
    a owl:DatatypeProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:range xsd:string ;
    rdfs:label "NCIt reviewer comment" ;
    rdfs:comment "Reviewer comment explaining the clinical limitation or mapping rationale." ;
    cskg:termStatus "reviewed qualified mapping" .

cskg:ncitMappingInterpretationLimit
    a owl:DatatypeProperty ;
    rdfs:domain cskg:CancerDiagnosis ;
    rdfs:range xsd:string ;
    rdfs:label "NCIt mapping interpretation limit" ;
    rdfs:comment "Interpretation limit attached to reviewed NCIt mappings so they are not treated as confirmed histology, registry diagnosis, stage, treatment, recurrence, or current disease status." ;
    cskg:termStatus "reviewed qualified mapping" .

cskg:dayOfWeekLabel
    a owl:DatatypeProperty ;
    rdfs:domain cskg:DailyMovementSummary ;
    rdfs:range xsd:string ;
    rdfs:label "day of week label" ;
    rdfs:comment "CDC/NHANES source label for the monitor day-of-week code." ;
    cskg:termStatus "source label ready" .

cskg:predictedWearStateLabel
    a owl:DatatypeProperty ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:string ;
    rdfs:label "predicted wear state label" ;
    rdfs:comment "CDC/NHANES source label for the minute-level predicted wake, sleep, non-wear, or unknown state." ;
    cskg:termStatus "source label ready" .

cskg:qualityFlagScoreLabel
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "quality flag score label" ;
    rdfs:comment "Source-label interpretation of the quality flag score, such as no quality flags or one or more quality flags." ;
    cskg:termStatus "source label ready" .

cskg:qualityFlagLabelDescription
    a owl:DatatypeProperty ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:string ;
    rdfs:label "quality flag label description" ;
    rdfs:comment "Description of an individual PAXFLGSM flag letter observed for a minute. Multiple values can occur for one observation." ;
    cskg:termStatus "source label ready" .

#################################################################
