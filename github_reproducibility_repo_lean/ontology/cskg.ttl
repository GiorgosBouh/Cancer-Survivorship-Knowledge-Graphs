#################################################################
# Synthetic harmonisation extension
#################################################################

cskg:ActivityDataSource
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "activity data source" ;
    rdfs:comment "A source pattern for accelerometry-derived activity data, such as NHANES wrist MIMS or the synthetic hip counts/minute demonstration source." ;
    cskg:termStatus "ready" .

cskg:HarmonisedSourceVariableMapping
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "harmonised source variable mapping" ;
    rdfs:comment "A mapping from a source-specific accelerometry variable to a harmonised construct, with compatibility status and interpretation limits." ;
    cskg:termStatus "ready" .

cskg:HarmonisedActivityDefinition
    a owl:Class ;
    rdfs:subClassOf prov:Plan ;
    rdfs:label "harmonised activity definition" ;
    rdfs:comment "A source-specific activity, completeness, or classification definition represented in the harmonisation layer." ;
    cskg:termStatus "ready" .

cskg:SyntheticDailyActivitySummary
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "synthetic daily activity summary" ;
    rdfs:comment "A deterministic synthetic hip-worn counts/minute participant-day summary used only to demonstrate semantic harmonisation mechanics. It is not measured hip accelerometry and not a conversion from wrist MIMS." ;
    cskg:compatibilityWarning "Synthetic source for review/demo only; do not use for epidemiologic effect estimation." ;
    cskg:termStatus "ready" .

cskg:CountsPerMinuteUnit
    a qudt:Unit ;
    rdfs:label "counts per minute" ;
    rdfs:comment "Source-specific vertical-axis counts/minute unit used by the synthetic hip-worn demonstration source. It is not numerically equivalent to wrist MIMS." ;
    cskg:termStatus "ready" .

cskg:mapsFromActivitySource
    a owl:ObjectProperty ;
    rdfs:domain cskg:HarmonisedSourceVariableMapping ;
    rdfs:range cskg:ActivityDataSource ;
    rdfs:label "maps from activity source" ;
    cskg:termStatus "ready" .

cskg:definedForActivitySource
    a owl:ObjectProperty ;
    rdfs:domain cskg:HarmonisedActivityDefinition ;
    rdfs:range cskg:ActivityDataSource ;
    rdfs:label "defined for activity source" ;
    cskg:termStatus "ready" .

cskg:fromActivitySource
    a owl:ObjectProperty ;
    rdfs:domain cskg:SyntheticDailyActivitySummary ;
    rdfs:range cskg:ActivityDataSource ;
    rdfs:label "from activity source" ;
    cskg:termStatus "ready" .

cskg:seededFromNhanesDay
    a owl:ObjectProperty ;
    rdfs:domain cskg:SyntheticDailyActivitySummary ;
    rdfs:range cskg:DailyMovementSummary ;
    rdfs:label "seeded from NHANES day" ;
    rdfs:comment "Links a synthetic demonstration day to the NHANES participant-day row used as its deterministic seed. This is provenance for a demo artifact, not evidence of cross-device measurement validation." ;
    cskg:termStatus "ready" .

cskg:hasSyntheticDailyActivitySummary
    a owl:ObjectProperty ;
    rdfs:domain cskg:Participant ;
    rdfs:range cskg:SyntheticDailyActivitySummary ;
    rdfs:label "has synthetic daily activity summary" ;
    cskg:termStatus "ready" .

cskg:sourceId
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "source identifier" ;
    cskg:termStatus "ready" .

cskg:sourceTable
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "source table" ;
    cskg:termStatus "ready" .

cskg:sourceVariableName
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "source variable name" ;
    cskg:termStatus "ready" .

cskg:sourceLabel
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "source label" ;
    cskg:termStatus "ready" .

cskg:sourceDeviceLocation
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "source device location" ;
    cskg:termStatus "ready" .

cskg:sourceDeviceType
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "source device type" ;
    cskg:termStatus "ready" .

cskg:sourceMovementMetric
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "source movement metric" ;
    cskg:termStatus "ready" .

cskg:sourceUnit
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "source unit" ;
    cskg:termStatus "ready" .

cskg:harmonisedConstruct
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "harmonised construct" ;
    cskg:termStatus "ready" .

cskg:harmonisedProperty
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "harmonised property" ;
    cskg:termStatus "ready" .

cskg:protocolRole
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "protocol role" ;
    cskg:termStatus "ready" .

cskg:compatibilityStatus
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "compatibility status" ;
    rdfs:comment "Harmonisation status such as compatible after protocol abstraction, source-specific metric, or not harmonisable with NHANES wrist MIMS in the current KG." ;
    cskg:termStatus "ready" .

cskg:harmonisationAction
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "harmonisation action" ;
    cskg:termStatus "ready" .

cskg:interpretationLimit
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "interpretation limit" ;
    cskg:termStatus "ready" .

cskg:threshold
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "threshold" ;
    cskg:termStatus "ready" .

cskg:definitionType
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "definition type" ;
    cskg:termStatus "ready" .

cskg:validWearMinutes
    a owl:DatatypeProperty ;
    rdfs:domain cskg:SyntheticDailyActivitySummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "valid wear minutes" ;
    cskg:termStatus "ready" .

cskg:dailyTotalAxisCounts
    a owl:DatatypeProperty ;
    rdfs:domain cskg:SyntheticDailyActivitySummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "daily total axis counts" ;
    cskg:compatibilityWarning "Source-specific synthetic hip counts; not numerically equivalent to wrist MIMS." ;
    cskg:termStatus "ready" .

cskg:meanAxisCountsPerMinute
    a owl:DatatypeProperty ;
    rdfs:domain cskg:SyntheticDailyActivitySummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "mean axis counts per minute" ;
    cskg:compatibilityWarning "Source-specific synthetic hip counts/minute metric." ;
    cskg:termStatus "ready" .

cskg:sourceDefinedMVPAMinutes
    a owl:DatatypeProperty ;
    rdfs:domain cskg:SyntheticDailyActivitySummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "source-defined MVPA minutes" ;
    rdfs:comment "MVPA minutes defined only by the synthetic hip counts/minute source-specific cut point. This must not be inferred for NHANES wrist MIMS." ;
    cskg:termStatus "ready" .

cskg:sourceDefinedSedentaryMinutes
    a owl:DatatypeProperty ;
    rdfs:domain cskg:SyntheticDailyActivitySummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "source-defined sedentary minutes" ;
    rdfs:comment "Sedentary minutes defined only by the synthetic hip counts/minute source-specific cut point. This must not be inferred for NHANES wrist MIMS." ;
    cskg:termStatus "ready" .

cskg:validDayUnderSourceProtocol
    a owl:DatatypeProperty ;
    rdfs:domain cskg:SyntheticDailyActivitySummary ;
    rdfs:range xsd:boolean ;
    rdfs:label "valid day under source protocol" ;
    cskg:termStatus "ready" .

