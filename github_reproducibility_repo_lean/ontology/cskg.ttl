    cskg:termStatus "ready" .

cskg:citedClaim
    a owl:DatatypeProperty ;
    rdfs:domain cskg:ProtocolCitationEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "cited claim" ;
    cskg:termStatus "ready" .

cskg:supportsProtocolComponent
    a owl:DatatypeProperty ;
    rdfs:domain cskg:ProtocolCitationEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "supports protocol component" ;
    cskg:termStatus "ready" .

cskg:supportLevel
    a owl:DatatypeProperty ;
    rdfs:domain cskg:ProtocolCitationEvidence ;
    rdfs:range xsd:string ;
