#################################################################
# Independent NHANES 2003-2006 PAM extension
#################################################################

cskg:IndependentPAMDailySummary
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "independent PAM daily summary" ;
    rdfs:comment "A participant-day summary from the independent NHANES 2003-2006 hip-worn ActiGraph Physical Activity Monitor source. These nodes are source-specific validation summaries and are not linked as the same participants as the NHANES 2011-2014 wrist/MIMS cohort." ;
    cskg:compatibilityWarning "Do not convert hip ActiGraph counts or steps to wrist MIMS, MVPA, sedentary time, or clinical physical-activity status." ;
    cskg:termStatus "ready" .

cskg:StepsPerMinuteUnit
    a qudt:Unit ;
    rdfs:label "steps per minute" ;
    rdfs:comment "Source-specific steps/minute unit used by NHANES 2005-2006 hip-worn ActiGraph PAM outputs. It is not numerically equivalent to wrist MIMS." ;
    cskg:termStatus "ready" .

cskg:sourceParticipantIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain cskg:IndependentPAMDailySummary ;
    rdfs:range xsd:integer ;
    rdfs:label "source participant identifier" ;
    rdfs:comment "Source-local participant identifier retained for independent validation summaries. It does not imply identity linkage to the NHANES 2011-2014 wrist/MIMS participants." ;
    cskg:termStatus "ready" .

cskg:reliableMinutes
    a owl:DatatypeProperty ;
    rdfs:domain cskg:IndependentPAMDailySummary ;
    rdfs:range xsd:integer ;
    rdfs:label "reliable minutes" ;
    cskg:sourceVariable "PAXSTAT" ;
    cskg:termStatus "ready" .

