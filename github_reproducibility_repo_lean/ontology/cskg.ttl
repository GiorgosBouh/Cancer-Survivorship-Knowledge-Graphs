cskg:cancerHistoryLabel
    a owl:DatatypeProperty ;
    rdfs:domain cskg:Participant ;
    rdfs:range xsd:string ;
    rdfs:label "cancer history label" ;
    rdfs:comment "CDC/NHANES source label for the self-reported cancer history code." ;
