@prefix cskg: <https://w3id.org/cskg/ontology/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/cskg/ontology/alignment-candidates>
    dct:title "CSKG ontology alignment candidates" ;
    dct:created "2026-08-11"^^xsd:date ;
    rdfs:comment "Candidate alignment module for ontology review. These mappings are intentionally weaker than owl:equivalentClass and should not be treated as finalized biomedical interoperability assertions." .

cskg:Participant
    skos:closeMatch foaf:Person ;
    skos:scopeNote "Candidate alignment only. cskg:Participant is a de-identified NHANES study participant role, not a named person identity." .

cskg:CancerHistoryAssertion
    rdfs:subClassOf prov:Entity ;
    skos:scopeNote "Source assertion entity derived from NHANES MCQ220. Candidate biomedical alignment should be reviewed before using OGMS/NCIt diagnosis classes." .

cskg:SelfReportedCancerHistory
    rdfs:subClassOf cskg:CancerHistoryAssertion ;
    skos:scopeNote "Self-report evidence class. Do not align directly to a clinically verified diagnosis class without evidence provenance constraints." .

cskg:CancerDiagnosis
    rdfs:subClassOf prov:Entity ;
    skos:scopeNote "Reported diagnosis slot. Candidate alignment to external diagnosis ontologies is pending review because the current evidence is NHANES self-report, not EHR or registry verification." .

cskg:DailyMovementSummary
    rdfs:subClassOf prov:Entity ;
    skos:relatedMatch sosa:Observation ;
    skos:scopeNote "Daily aggregate summaries are related to, but not the same as, minute-level SOSA observations." .

cskg:DerivedMovementFeatureSet
    rdfs:subClassOf prov:Entity ;
    skos:scopeNote "Derived movement features are PROV entities generated by local software execution." .

cskg:ProcessingProtocol
    rdfs:subClassOf prov:Plan ;
    skos:scopeNote "Processing protocols are represented as PROV plans because they specify executable completeness/sensitivity rules." .

cskg:ProtocolApplicationResult
    rdfs:subClassOf prov:Entity ;
    skos:scopeNote "Protocol application results are generated entities, not clinical classifications." .

cskg:MIMSUnit
    rdfs:subClassOf qudt:Unit ;
    skos:scopeNote "Custom project unit for MIMS. No UCUM code is asserted because MIMS is an algorithmic movement-summary metric." .
